{
  "manifest_version": 3,
  "name": "Word Filter - 단어 필터링",
  "version": "1.11.0",
  "description": "등록한 텍스트 또는 정규표현식을 블록/단어 단위로 지정한 컬러(RGB + Opacity)로 필터링합니다.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Word Filter",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/shared/filter_settings_storage.js",
        "src/shared/filter_apply_helper.js",
        "src/content/word_filter_content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "css": [
        "src/content/word_filter_styles.css"
      ]
    }
  ]
}
